sample='SRR11364933' # SRR or FS library name - should match fastq file

barcode='TCA' #Revcomp of library barcode, e.g. it was TGA here
pattern='NNNNNNXXXNN' #UMI/barcode sequence; N=UMI, X=barcode
technique='ribose-seq' #options are ribose-seq, emRiboSeq, hydenseq, pu-seq

repository='path/to/output' #output path

basename='path/to/sacCer2' #absolute path to genome index files, no extension!!
fasta='path/to/sacCer2.fa' #absolute path to ref genome

read1='path/to/SRR11364933_trimmed.fq' #absolute path to raw reads

quality='0' #min mapq
threads='4' #number of threads for alignment = number of processors = nodes x processors per node (ppn)

seed='123456789' #random seed to be used. Don't change!

percentile='0.99' # Percentile of hotspots; 0.99 means top 1% (0.01) are defined as hotspots

mismatches='0' #number of MMs allowed in alignment

units='chrM 2micron' #chrM 2 micron for yeast, chromosome_m chloroplast for algae
